# Variables de entorno para FastAPI Chatbot
# IMPORTANTE: NO SUBIR ESTE ARCHIVO A GIT (añadir a .gitignore)

# OpenAI Configuration
OPENAI_API_KEY=tu_api_key_aqui
OPENAI_MODEL=gpt-4o-mini

# Database Configuration
DB_HOST=localhost
DB_NAME=pecosol_db
DB_USER=root
DB_PASSWORD=
DB_PORT=3306

# Server Configuration
API_HOST=127.0.0.1
API_PORT=8000

# Timezone para reportes diarios del chatbot
# Ejemplos: -05:00 (Colombia/Peru), -06:00, -03:00
APP_TIMEZONE_OFFSET=-05:00
# true si sale_date se guarda en UTC; false si ya se guarda en hora local
SALES_DATETIME_IS_UTC=true
