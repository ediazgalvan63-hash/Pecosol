RewriteEngine On

# Excluir archivos específicos de debug y admin
RewriteCond %{REQUEST_URI} ^/(debug_request|diagnose|verify_chatbot)\.php$ [OR]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^.*$ - [L]

# IMPORTANTE: Si es una carpeta que existe, permitir acceso directo
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^.*$ - [L]

# Solo después de eso, reescribir rutas virtuales a index.php
# Esto permite que /health y /api/chat lleguen a index.php
RewriteRule ^(.*)$ index.php [QSA,L]
