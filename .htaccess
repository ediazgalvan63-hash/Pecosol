RewriteEngine On

# IMPORTANTE: Si es una carpeta que existe, permitir acceso directo
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^.*$ - [L]

# IMPORTANTE: Si es un archivo que existe, permitir acceso directo (incluyendo .php)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^.*$ - [L]

# Solo después de eso, reescribir rutas virtuales a index.php
# Esto permite que /health y /api/chat lleguen a index.php
RewriteRule ^(.*)$ index.php [QSA,L]
