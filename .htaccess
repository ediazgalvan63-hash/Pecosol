RewriteEngine On

# Si es una carpeta que existe, permitir acceso directo
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^.*$ - [L]

# Si es un archivo que existe, permitir acceso directo
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^.*$ - [L]

# Enviar TODO a index.php (incluido /health y /api/chat)
# index.php manejará estas rutas especiales
RewriteRule ^(.*)$ index.php [QSA,L]
